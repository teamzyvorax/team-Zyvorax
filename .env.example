# API
PORT=4000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/team_zyvorax

# Frontend build-time API origin
VITE_API_URL=http://localhost:4000

# Optional: enables model-backed ZyvoraX AI (never expose in frontend)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: enables user-triggered generated-app deployments to Vercel
VERCEL_TOKEN=
